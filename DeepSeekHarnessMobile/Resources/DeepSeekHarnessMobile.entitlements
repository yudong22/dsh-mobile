<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Push Notifications capability for com.clark.dshmobile.

	  `development` matches the Debug build's provisioning profile; distribution
	  builds need `production`. The value must match the profile, so it is set
	  per build configuration in project.pbxproj rather than committed twice.
	-->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>